# Terra Analog runtime configuration (all optional; defaults shown).
# Copy to your hosting provider's environment settings. No secrets are required.

# HTTP port the service listens on (most hosts inject PORT automatically).
PORT=8000

# Uvicorn worker processes. Each worker keeps its own copy of reference data.
WEB_CONCURRENCY=1

# Terrain analyses allowed to run at once per worker, and how long (seconds)
# a request may wait for a free slot before receiving 503 SERVER_BUSY.
TERRA_MAX_CONCURRENT_ANALYSES=2
TERRA_ANALYSIS_QUEUE_TIMEOUT_S=60

# Serve the static frontend from the API (same origin). Set to 0 when the
# frontend is hosted elsewhere, and then list its origin(s) below.
TERRA_SERVE_FRONTEND=1
# TERRA_FRONTEND_DIR=/app/frontend

# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the frontend is served by this service. "*" is ignored.
# TERRA_CORS_ORIGINS=https://terra-analog.example.org
